{
  "name": "cdc-ap-sqlserver",
  "config": {
    "connector.class": "io.debezium.connector.sqlserver.SqlServerConnector",
    "database.hostname": "sqlserver",
    "database.port": "1433",
    "database.user": "${file:/secrets/mssql.properties:user}",
    "database.password": "${file:/secrets/mssql.properties:password}",
    "database.names": "ASSUREPLUS",
    "database.encrypt": "true",
    "topic.prefix": "prd.ap.raw",
    "table.include.list": "dbo.AP_USERS,dbo.AP_CONTRACTS,dbo.AP_CLAIMS,dbo.AP_PAYMENTS",
    "snapshot.mode": "no_data",
    "transforms": "route",
    "transforms.route.type": "org.apache.kafka.connect.transforms.RegexRouter",
    "transforms.route.regex": "prd\\.ap\\.raw\\.ASSUREPLUS\\.dbo\\.AP_(.*)",
    "transforms.route.replacement": "prd.ap.raw.$1.v1",
    "key.converter": "io.confluent.connect.avro.AvroConverter",
    "value.converter": "io.confluent.connect.avro.AvroConverter",
    "key.converter.schema.registry.url": "http://schema-registry:8081",
    "value.converter.schema.registry.url": "http://schema-registry:8081",
    "schema.history.internal.kafka.bootstrap.servers": "kafka:9092",
    "schema.history.internal.kafka.topic": "_schema_history_ap"
  }
}
